{
  "version": 2,
  "plugins": [
    {
      "id": "open_meteo_weather",
      "name": "Open-Meteo 实时天气",
      "description": "全球任意经纬度的实时天气、风速与空气质量查询。免密钥,装完即用。",
      "category": "气象预报",
      "auth_type": "none",
      "base_url": "https://api.open-meteo.com/v1",
      "tools": [
        {
          "name": "get_forecast",
          "summary": "查询指定经纬度的实时天气(温度/风速等要素可选)",
          "method": "GET",
          "path": "/forecast",
          "params": [
            {
              "name": "latitude",
              "description": "纬度,如 39.9",
              "required": true,
              "type": "number"
            },
            {
              "name": "longitude",
              "description": "经度,如 116.4",
              "required": true,
              "type": "number"
            },
            {
              "name": "current",
              "description": "要返回的实时要素,逗号分隔",
              "required": false,
              "type": "string",
              "default": "temperature_2m,wind_speed_10m,relative_humidity_2m"
            },
            {
              "name": "timezone",
              "description": "时区,auto 按经纬度自动",
              "required": false,
              "type": "string",
              "default": "auto"
            }
          ]
        },
        {
          "name": "get_air_quality",
          "summary": "查询指定经纬度的空气质量(欧洲指数与 PM2.5 等)",
          "method": "GET",
          "path": "/air-quality",
          "params": [
            {
              "name": "latitude",
              "description": "纬度",
              "required": true,
              "type": "number"
            },
            {
              "name": "longitude",
              "description": "经度",
              "required": true,
              "type": "number"
            }
          ]
        }
      ],
      "icon": "https://open-meteo.com/favicon.ico"
    },
    {
      "id": "sunrise_sunset",
      "name": "日出日落时刻",
      "description": "全球任意经纬度的日出、日落、昼长与暮光时刻。免密钥。",
      "category": "气象预报",
      "auth_type": "none",
      "base_url": "https://api.sunrise-sunset.org",
      "tools": [
        {
          "name": "get_times",
          "summary": "查询指定经纬度某日的日出日落时刻",
          "method": "GET",
          "path": "/json",
          "params": [
            {
              "name": "lat",
              "description": "纬度,如 39.9",
              "required": true,
              "type": "number"
            },
            {
              "name": "lng",
              "description": "经度,如 116.4",
              "required": true,
              "type": "number"
            },
            {
              "name": "date",
              "description": "日期 YYYY-MM-DD,默认今天",
              "required": false,
              "type": "string"
            },
            {
              "name": "formatted",
              "description": "为0返回24小时制时间",
              "required": false,
              "type": "string",
              "default": "0"
            }
          ]
        }
      ],
      "icon": "https://www.google.com/s2/favicons?domain=api.sunrise-sunset.org&sz=64"
    },
